{
  "name": "vublox-web",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "scripts": {
    "prestart": "node generate-build-version",
    "prebuild": "node generate-build-version && cp node_modules/mediainfo.js/dist/MediaInfoModule.wasm node_modules/mediainfo.js/dist/esm-bundle/",
    "start": "craco start",
    "server": "nodemon server.js",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "build": "CI='' craco build && cp ./public/.htaccess build && npm run sentry:sourcemaps",
    "build-local": "craco --max-old-space-size=8192 build && cp ./public/.htaccess build",
    "test": "craco test",
    "eject": "craco eject",
    "format": "prettier --write src/**/*.ts{,x}",
    "lint": "eslint ./src/app",
    "lint-fix": "eslint ./src/app --fix",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org jlabs-fa --project vublox-web-n5 ./build && sentry-cli sourcemaps upload --org jlabs-fa --project vublox-web-n5 ./build"
  },
  "dependencies": {
    "@firebase/auth": "^1.5.1",
    "@sentry/cli": "^2.34.1",
    "@sentry/react": "^7.104.0",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@uiw/react-amap": "^7.1.4",
    "@uiw/react-amap-types": "^7.1.4",
    "@vis.gl/react-google-maps": "^1.4.0",
    "apple-mapkit-js": "^6.1.0",
    "axios": "^1.6.2",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.4",
    "chartjs-adapter-moment": "^1.0.1",
    "classnames": "^2.5.1",
    "debounce-promise": "^3.1.2",
    "dompurify": "^3.1.7",
    "exifr": "^7.1.3",
    "firebase": "^10.8.1",
    "html2canvas": "^1.4.1",
    "lodash": "^4.17.21",
    "mapkit-react": "^1.15.1",
    "mediainfo.js": "^0.3.5",
    "mime": "^4.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "numeral": "^2.0.6",
    "parse-full-name": "^1.2.6",
    "path-parser": "^6.1.0",
    "pluralize": "^8.0.0",
    "pretty-bytes": "^6.1.1",
    "prop-types": "^15.7.2",
    "pusher-js": "^8.4.0-rc2",
    "react": "^18.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-circular-progressbar": "^2.1.0",
    "react-content-loader": "^7.0.0",
    "react-contenteditable": "^3.3.7",
    "react-datepicker": "^6.9.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.0.0",
    "react-dropzone": "^14.2.3",
    "react-fast-marquee": "^1.6.5",
    "react-infinite-scroll-component": "^6.1.0",
    "react-localization": "^1.0.19",
    "react-password-strength-bar": "^0.4.1",
    "react-perfect-scrollbar": "^1.5.8",
    "react-player": "^2.16.0",
    "react-qr-code": "^2.0.15",
    "react-range-slider-input": "^3.0.7",
    "react-redux": "^8.0.0",
    "react-responsive": "^10.0.0",
    "react-router-dom": "^6.22.2",
    "react-scripts": "^5.0.1",
    "react-select": "^5.8.3",
    "react-share": "^5.1.0",
    "react-spinners": "^0.13.8",
    "react-time-picker": "^7.0.0",
    "react-timer-hook": "^3.0.7",
    "react-toastify": "^10.0.4",
    "react-tracking": "^9.3.2",
    "react-transition-group": "^4.4.5",
    "react-uuid": "^1.0.2",
    "react-verification-code-input": "^1.2.9",
    "react-visibility-sensor": "^5.1.1",
    "react-webcam": "^7.2.0",
    "reactstrap": "^9.2.1",
    "redux": "^4.2.0",
    "redux-actions": "^2.6.5",
    "redux-debounce": "^1.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.1",
    "sass": "^1.69.5",
    "sweetalert2": "^11.4.8",
    "swiper": "^10.3.1",
    "typescript": "^5.3.3",
    "tz-lookup": "^6.1.25",
    "uuid": "^9.0.1",
    "web-vitals": "^0.2.4",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@craco/craco": "^5.9.0",
    "@craco/types": "^7.1.0",
    "@types/apple-mapkit-js": "^5.50.0",
